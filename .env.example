# Copy to .env.local for local development. Never commit real values.

# Passcode for the /admin dashboard (required to enable admin access).
# 4–8 digits shows a PIN pad; anything else shows a password field.
# 1704 is for local demos only — use a long, unique passcode in production.
ADMIN_PASSCODE=1704

# Postgres connection string (e.g. Supabase / Neon). Unset → local JSON file (dev only).
# Required on Vercel — the app refuses to run a file store on serverless.
DATABASE_URL=

# TLS for DATABASE_URL (non-local hosts). Default: encrypted, certificate not verified.
# Set a CA certificate (PEM, \n-escaped ok) for verified TLS, or DATABASE_SSL_VERIFY=true to use system CAs.
DATABASE_CA_CERT=
DATABASE_SSL_VERIFY=
# Max pooled connections per serverless instance.
DATABASE_POOL_MAX=5

# Comma-separated domains allowed to mark attendance.
ALLOWED_EMAIL_DOMAINS=innovinlabs.com

# Hour (0–24, IST) after which orders close. 24 = open all day (default); 11 = 11:00 AM.
ORDER_CUTOFF_HOUR=24

# Annual paid-leave allowance per person, in days. Drives the leave balance on
# /away and the per-person usage table in admin. Default 12.
# Leave entitlements come from the policy engine (lib/leave.ts) and the imported per-person
# figures in data/leave-2026.json — there is no allowance env var.

# Wi-Fi speed test source. Unset (default) measures against fast.com's nearest Netflix CDN
# node; set to "self" to use only our own 2 MB payload — a kill switch if fast.com's
# undocumented endpoint ever changes, and what the e2e suite uses so tests stay offline.
SPEEDTEST_PROVIDER=

# Office geofence for attendance. Check-ins inside the radius are tagged "In office";
# outside → "Working remotely". Unset → every check-in is "Location not shared".
# Get coordinates by right-clicking the office in Google Maps.
OFFICE_LAT=
OFFICE_LNG=
OFFICE_RADIUS_M=300

# Google sign-in for verified employee identity (innovinlabs.com Workspace).
# Create an OAuth "Web application" client in Google Cloud Console with redirect URI
# <app-url>/api/auth/callback. Unset → sign-in is hidden and attendance stays email-typed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional separate secret for employee session cookies (falls back to ADMIN_PASSCODE).
SESSION_SECRET=

# Comma-separated emails granted the "owner" role when they sign in with Google. Owners grant
# and revoke admin from the dashboard's Access card. An owner's role can only be changed here,
# never through the app — so this is also the recovery path if an owner account is lost.
OWNER_EMAILS=

# Vercel CLI token for deploys (never commit).
VERCEL_TOKEN=

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
# The public key is served to browsers; the private key signs pushes and must stay secret.
# Leave unset to disable push entirely — the in-app notification feed still works.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@innovinlabs.com
