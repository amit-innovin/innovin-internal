# Copy to .env.local for local development. Never commit real values.

# Postgres connection string (e.g. Supabase / Neon). Unset → local JSON file (dev only).
# Required on Vercel — the app refuses to run a file store on serverless.
DATABASE_URL=

# TLS for DATABASE_URL (non-local hosts). Certificate verification is always required.
# Set the trusted provider CA certificate (PEM, \n-escaped ok) when it is not in system CAs.
DATABASE_CA_CERT=
DATABASE_SSL_VERIFY=
# Max pooled connections per serverless instance.
DATABASE_POOL_MAX=5

# Comma-separated domains allowed to mark attendance.
ALLOWED_EMAIL_DOMAINS=innovinlabs.com

# Hour (0–24, IST) after which orders close. 24 = open all day (default); 11 = 11:00 AM.
ORDER_CUTOFF_HOUR=24

# Optional real company prize description shown in the steps arena. No prize is promised
# when unset. Example: "October walking challenge: details from the People team."
STEPS_PRIZE_DESCRIPTION=

# Annual paid-leave allowance per person, in days. Drives the leave balance on
# /away and the per-person usage table in admin. Default 12.
# Leave entitlements come from the policy engine (lib/leave.ts) and the imported per-person
# figures in data/leave-2026.json — there is no allowance env var.

# Wi-Fi speed test source. Unset (default) measures against fast.com's nearest Netflix CDN
# node; set to "self" to use only our own 2 MB payload — a kill switch if fast.com's
# undocumented endpoint ever changes, and what the e2e suite uses so tests stay offline.
SPEEDTEST_PROVIDER=

# Office geofence for attendance. Check-ins inside the radius are tagged "In office";
# outside → "Working remotely". Unset → every check-in is "Location not shared".
# Get coordinates by right-clicking the office in Google Maps.
OFFICE_LAT=
OFFICE_LNG=
OFFICE_RADIUS_M=300

# Google sign-in for verified employee identity (innovinlabs.com Workspace).
# Create an OAuth "Web application" client in Google Cloud Console with redirect URI
# <app-url>/api/auth/callback. Unset → attendance and directory are unavailable until Google sign-in is configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Required: signs employee sessions and OAuth state. Use a long random value in production
# (openssl rand -hex 32); changing it signs everyone out.
SESSION_SECRET=local-dev-secret

# Comma-separated emails made admin whenever they sign in with Google. These admins can't be
# demoted in-app — this list is the recovery path if every other admin is lost. Any admin can
# grant or revoke admin for other members from the dashboard's Access card.
ADMIN_EMAILS=

# Vercel CLI token for deploys (never commit).
VERCEL_TOKEN=

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
# The public key is served to browsers; the private key signs pushes and must stay secret.
# Leave unset to disable push entirely — the in-app notification feed still works.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@innovinlabs.com

# Optional read-only Zoho People connection. Keep all credentials server-side.
# Obtain an organization-specific refresh token with ZOHOPEOPLE.leave.READ only.
# Data center suffix: com, in, eu, com.au, com.cn. Must match the OAuth account.
ZOHO_DATA_CENTER=in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Match the date format configured for your Zoho organization.
ZOHO_DATE_FORMAT=dd-MMM-yyyy
ZOHO_PEOPLE_PORTAL_ID=
# Explicit mappings; IDs MUST be quoted strings to preserve their precision.
# Example: {"person@innovinlabs.com":"140333000000326003"}
ZOHO_EMPLOYEE_IDS={}
# Example: {"cl":"type-id","sl":"type-id","el":"type-id","fl":"type-id"}
ZOHO_LEAVE_TYPE_IDS={}

# Instamart office purchasing (admin Google sign-in required).
# Generate a stable encryption key: openssl rand -hex 32. Back it up securely; losing or
# replacing it makes saved provider tokens and order attempts unreadable. Never expose it.
PANTRY_INTEGRATION_KEY=
# Exact HTTPS callback registered with Swiggy for production access. Localhost defaults to
# http://localhost:3000/api/pantry-provider/callback for self-serve development.
PANTRY_SWIGGY_REDIRECT_URI=
# Keep false until provider access, office account/address and COD are verified live.
# This release supports only returned Cash/COD methods, not UPI/wallet payment.
PANTRY_ORDERING_ENABLED=false
