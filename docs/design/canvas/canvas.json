  "notes": {
    "protoNote": {
      "fill": "blue",
      "text": "Press Play. Bottom bar: Home, Feed, Days, Snacks, Account. Feed has events, polls, kudos, announcements, birthdays, photos and notes. Account holds settings, Speak up, Wi-Fi check, Help and Sign out. Rule: chunky bottom edge = tappable, flat = information.",
      "w": 390,
      "x": 0,
      "y": -240
    },
    "respNote": {
      "fill": "blue",
      "w": 900,
      "x": 0,
      "y": 960,
      "text": "Desktop and tablet, v3: Feed is a separate page, not merged into Home. Sidebar: Home, Feed, Days, Tea & snacks, 10K steps, Reading list. Account menu at the bottom: Settings, Speak up, Wi-Fi check, Help, Sign out. Home centre: check-in, office days, who's around, a short 'From the feed' peek. Right rail: chai, coming up, step league, reading now. Tablet: icon sidebar, rail folds into the column."
    },
    "adminNote": {
      "fill": "blue",
      "w": 900,
      "x": 0,
      "y": 2640,
      "text": "Admin. An admin is an employee first: same app, same Home, Feed, Days and Snacks. Extra powers show up in two ways. (1) In place: on the Feed an admin can post an announcement, create or edit an event, and remove a post. (2) One Admin area, reached from Account on the phone and from the sidebar on desktop: Overview, People & office days, Speak up inbox, Snack shelf, Wi-Fi reports. Leave is NOT here: requests go to Zoho People and are approved there by each person's approver. Members never see the Admin area."
    },
    "deskNote": {
      "fill": "blue",
      "w": 900,
      "x": 0,
      "y": 4960,
      "text": "Laptop pages (≥1100px), added 11 Nov. Same sidebar as Home. Every page has a bell that opens the Notifications page. It is its own page on every size and never opens the Feed. Feed, Days, Tea & snacks, 10K steps and Reading list keep a right rail. Account is one page for profile and settings; Speak up, Wi-Fi check, Help and Sign out stay in the account menu. New post now has four kinds: Quote, Feedback, Kudos, Poll. Anyone can post a poll or kudos."
    },
    "tabNote": {
      "fill": "blue",
      "w": 900,
      "x": 0,
      "y": 7720,
      "text": "Tablet pages. Icon sidebar, one column. Whatever sits in the right rail on a laptop drops below the main column in the same order."
    },
    "adminDeskNote": {
      "fill": "blue",
      "w": 900,
      "x": 0,
      "y": 10850,
      "text": "Admin sub-pages on a laptop: People & office days, Speak up inbox, Snack shelf, Wi-Fi reports. Overview is the board above. Still no leave approvals: leave is decided in Zoho People."
    }
  },
